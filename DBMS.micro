<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MahaVitaran Bill - May 2026</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: Arial, sans-serif;
    background: #f0f2f5;
    padding: 20px;
    color: #222;
  }
  .bill {
    max-width: 850px;
    margin: 0 auto;
    background: #fff;
    border: 2px solid #333;
    padding: 25px;
  }
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 3px double #333;
    padding-bottom: 12px;
    margin-bottom: 15px;
  }
  .header h1 {
    font-size: 26px;
    color: #c0392b;
  }
  .header h1 small {
    display: block;
    font-size: 12px;
    color: #555;
    font-weight: normal;
  }
  .header .bill-period {
    text-align: right;
    font-size: 14px;
    font-weight: bold;
  }
  .header .bill-period span {
    display: block;
    font-size: 12px;
    font-weight: normal;
    color: #666;
  }

  .info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 20px;
    font-size: 13px;
    margin-bottom: 15px;
    padding: 10px;
    background: #fafafa;
    border: 1px solid #ddd;
  }
  .info-grid .row {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dotted #ccc;
    padding: 3px 0;
  }
  .info-grid .label { color: #555; }
  .info-grid .value { font-weight: 600; text-align: right; }

  h3 {
    font-size: 15px;
    background: #333;
    color: #fff;
    padding: 6px 10px;
    margin: 18px 0 10px 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-bottom: 10px;
  }
  th, td {
    border: 1px solid #bbb;
    padding: 6px 8px;
    text-align: center;
  }
  th {
    background: #eaeaea;
    font-weight: 600;
  }
  tr:nth-child(even) td { background: #f9f9f9; }

  .amount-box {
    border: 2px solid #c0392b;
    padding: 12px 15px;
    margin: 15px 0;
    font-size: 14px;
    background: #fff8f8;
  }
  .amount-box .row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
    border-bottom: 1px dotted #ccc;
  }
  .amount-box .row:last-child { border-bottom: none; }
  .amount-box .highlight {
    font-size: 18px;
    font-weight: bold;
    color: #c0392b;
  }

  .note {
    background: #fff3cd;
    border-left: 5px solid #ffc107;
    padding: 10px 15px;
    font-size: 13px;
    margin: 15px 0;
  }

  .footer {
    text-align: center;
    font-size: 11px;
    color: #777;
    margin-top: 20px;
    border-top: 1px dashed #aaa;
    padding-top: 10px;
  }
</style>
</head>
<body>

<div class="bill">

  <!-- HEADER -->
  <div class="header">
    <h1>⚡ MahaVitaran
      <small>Maharashtra State Electricity Distribution Co. Ltd.</small>
    </h1>
    <div class="bill-period">
      Individual Bill of Supply
      <span>BILL OF SUPPLY FOR THE MONTH OF - May 2026</span>
    </div>
  </div>

  <!-- CUSTOMER INFO -->
  <div class="info-grid">
    <div class="row"><span class="label">Bill Number</span><span class="value">000003339073</span></div>
    <div class="row"><span class="label">Consumer Number</span><span class="value">463020072318</span></div>
    <div class="row"><span class="label">Consumer Name</span><span class="value">Tarabai Waman Bhanarkar</span></div>
    <div class="row"><span class="label">Address</span><span class="value">Bhanarkar Wadi, Sakri</span></div>
    <div class="row"><span class="label">Billing Unit</span><span class="value">4331/BRAMHAPURI</span></div>
    <div class="row"><span class="label">Tariff</span><span class="value">90LT I Res 1-Phase</span></div>
    <div class="row"><span class="label">Meter Number</span><span class="value">SWUA/11</span></div>
    <div class="row"><span class="label">Connection Date</span><span class="value">14-04-1993</span></div>
    <div class="row"><span class="label">Sanctioned Load</span><span class="value">2.80 KW</span></div>
    <div class="row"><span class="label">GSTIN</span><span class="value">27AAECM2933K1ZB</span></div>
  </div>

  <!-- METER READINGS -->
  <h3>📊 Meter Readings</h3>
  <table>
    <thead>
      <tr>
        <th>Previous Reading</th>
        <th>Current Reading</th>
        <th>Multiplying Factor</th>
        <th>Units Consumed</th>
        <th>Adjustment</th>
        <th>Total Units</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>9103</td>
        <td>9267</td>
        <td>1.00</td>
        <td><b>159</b></td>
        <td>0</td>
        <td><b>159</b></td>
      </tr>
    </tbody>
  </table>

  <!-- MONTHLY CONSUMPTION -->
  <h3>📈 Monthly Consumption (Units)</h3>
  <table>
    <thead>
      <tr>
        <th>Month</th><th>Units</th>
        <th>Month</th><th>Units</th>
      </tr>
    </thead>
    <tbody>
      <tr><td>April 2026</td><td>113</td><td>October 2025</td><td>109</td></tr>
      <tr><td>March 2026</td><td>61</td><td>September 2025</td><td>103</td></tr>
      <tr><td>February 2026</td><td>42</td><td>August 2025</td><td>109</td></tr>
      <tr><td>January 2026</td><td>31</td><td>July 2025</td><td>150</td></tr>
      <tr><td>December 2025</td><td>37</td><td>June 2025</td><td>159</td></tr>
      <tr><td>November 2025</td><td>99</td><td></td><td></td></tr>
    </tbody>
  </table>

  <!-- AMOUNT DETAILS -->
  <h3>💰 Bill Amount Details (₹ Indian Rupees)</h3>
  <div class="amount-box">
    <div class="row"><span>Bill Date</span><span>12-05-2026</span></div>
    <div class="row"><span>Due Date</span><span><b>01-06-2026</b></span></div>
    <div class="row"><span>Bill Amount</span><span class="highlight">₹ 1750.00</span></div>
    <div class="row"><span>Amount After Due Date</span><span class="highlight">₹ 1770.00</span></div>
  </div>

  <!-- IMPORTANT NOTE -->
  <div class="note">
    ⚠️ <b>Important:</b> Please pay this bill before <b>01-06-2026</b>.<br>
    If paid late, you will have to pay <b>₹ 1770.00</b> (₹20 extra).
  </div>

  <!-- FOOTER -->
  <div class="footer">
    This bill is computer generated. Signature not required.<br>
    For more info: www.mahadiscom.in | Helpline: 1912
  </div>

</div>

</body>
</html>
